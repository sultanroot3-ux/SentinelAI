# Direct runtime dependencies of the SentinelAI backend.
#
# This is the file humans edit. The pinned, hash-verified lock file that Docker
# and CI actually install from is requirements.txt, regenerated with:
#
#     ./scripts/lock-requirements.sh
#
# which runs pip-compile inside a linux/amd64 python:3.11-slim container so the
# resolution matches the production image rather than the developer's laptop.

fastapi
uvicorn[standard]
sqlalchemy
alembic
pydantic
pydantic-settings
email-validator
python-jose[cryptography]
# bcrypt 5 raises on >72-byte passwords instead of truncating; app.core.security
# truncates explicitly to stay compatible with existing $2b$ hashes.
bcrypt==5.0.0
python-multipart
# OpenCV 5.x removed the legacy CascadeClassifier API the Haar fallback uses
opencv-python>=4.14.0.94,<5
numpy
# PostgreSQL driver (SQLite needs nothing extra)
psycopg2-binary
# Notifications + report exports
requests
reportlab
openpyxl
# Shared cross-worker state for rate limiting and pipeline cooldowns (B4).
# Required whenever UVICORN_WORKERS > 1 — see app/core/shared_state.py.
redis
